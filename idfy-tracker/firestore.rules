rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().status == 'approved';
    }
    function myRole() { return myProfile().role; }
    function isAdmin() { return isApproved() && myRole() == 'admin'; }
    function isMember() { return isApproved() && myRole() == 'member'; }
    function isIntern() { return isApproved() && myRole() == 'intern'; }

    // IMPORTANT: keep this list identical to ADMIN_EMAILS in
    // js/firebase-config.js. It only matters for a user's very first
    // sign-in (before any admin document exists) — every self-created
    // profile MUST be either "pending" or this exact bootstrap-admin shape,
    // never anything a client could use to self-approve.
    function isBootstrapAdminEmail() {
      return request.auth.token.email in ['ankur.katyarmal@gmail.com'];
    }

    // Invites let an admin pre-approve someone by email, before they've
    // ever signed in. Doc id = lowercased email. Only matters on a user's
    // very first sign-in — see the /users create rule below.
    function hasInvite() {
      return exists(/databases/$(database)/documents/invites/$(request.auth.token.email));
    }
    function inviteRole() {
      return get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.role;
    }

    match /users/{uid} {
      // Read your own profile always; read anyone's once you're approved
      // (needed for the admin/member "assign owner" pickers and the
      // Access Requests / All Users lists).
      allow read: if request.auth != null && (request.auth.uid == uid || isApproved());

      // A user may only ever create THEIR OWN doc, and only in one of three
      // shapes: a normal pending request; an already-approved admin record
      // (solely for emails in the bootstrap admin list); or an
      // already-approved record matching a role an admin pre-set via an
      // invite. No other combination of role/status is accepted on
      // create, so nobody can self-approve or self-promote by writing
      // their own profile.
      allow create: if request.auth != null && request.auth.uid == uid && (
        (
          !isBootstrapAdminEmail() && !hasInvite()
          && request.resource.data.status == 'pending'
          && request.resource.data.role in ['viewer', 'member', 'intern', 'viewer_download']
        ) || (
          isBootstrapAdminEmail()
          && request.resource.data.status == 'approved'
          && request.resource.data.role == 'admin'
        ) || (
          hasInvite() && !isBootstrapAdminEmail()
          && request.resource.data.status == 'approved'
          && request.resource.data.role == inviteRole()
        )
      );

      // Only an admin can change anyone's status/role after creation
      // (approve, reject, revoke, change role) — including their own.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Invites: admin pre-approves an email + role before that person ever
    // signs in. The invited person can read (not write) their own invite
    // doc so the client can show them nothing unusual — the actual grant
    // happens via the /users create rule above, driven by hasInvite().
    match /invites/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Projects: an admin can read/write any project. A member can create a
    // project only as its own owner, and can only edit/delete projects they
    // already own. Interns never write here directly — their proposals go
    // through /pendingChanges and only become real writes once an admin or
    // the project's owner applies the approved change (as that same admin
    // or owning member, so this same rule still governs the actual write).
    //
    // READ VISIBILITY: a Member sees only projects they own UNLESS an admin
    // has granted them full portfolio view (myProfile().canViewAll == true).
    // Everyone else who's approved (Admin, Intern, Viewer, Viewer+Download)
    // sees everything, same as before — this restriction is Member-only.
    // The app's Storage.subscribe() query must match this exactly (adds a
    // where("ownerEmail","==",email) clause for restricted Members) or
    // Firestore will reject the unfiltered list query outright.
    function canSeeAllProjects() {
      return isAdmin()
        || (isApproved() && myRole() in ['viewer', 'viewer_download', 'intern'])
        || (isMember() && myProfile().canViewAll == true);
    }
    match /projects/{projectId} {
      allow read: if canSeeAllProjects()
        || (isMember() && resource.data.ownerEmail == request.auth.token.email);
      allow create: if isAdmin()
        || (isMember() && request.resource.data.ownerEmail == request.auth.token.email);
      allow update, delete: if isAdmin()
        || (isMember() && resource.data.ownerEmail == request.auth.token.email);
    }

    // Pending changes: an intern can create their own proposal (status
    // must start "pending" and be attributed to themselves — no one can
    // submit a change on someone else's behalf or pre-mark it approved).
    // Any approved user can read the queue (the app itself filters what
    // each role actually sees). Only an admin, or the member matching
    // targetOwnerEmail, can update a proposal's status (approve/reject).
    // Only an admin can delete a proposal outright.
    match /pendingChanges/{changeId} {
      allow read: if isApproved();
      allow create: if isIntern()
        && request.resource.data.submittedBy == request.auth.token.email
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (isMember() && resource.data.targetOwnerEmail == request.auth.token.email);
      allow delete: if isAdmin();
    }

    // Public dashboard snapshot: a deliberately curated, high-level-only
    // copy of portfolio status that an admin explicitly publishes. This is
    // the ONE piece of data in this whole database readable with NO sign-in
    // at all — by design, for a share-with-anyone leadership link. It never
    // contains dependency notes, activity history, or emails; see
    // buildPublicSnapshot() in js/app.js for exactly what goes in it.
    match /publicSnapshots/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shared config docs (e.g. the Owner/Requested-By team directory used
    // to populate dropdowns). Any approved user reads it; only an admin
    // maintains the roster.
    match /config/{docId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }
  }
}
