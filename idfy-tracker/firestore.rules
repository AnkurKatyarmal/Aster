rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().status == 'approved';
    }
    function isEditor() {
      return isApproved() && (myProfile().role == 'editor' || myProfile().role == 'admin');
    }
    function isAdmin() {
      return isApproved() && myProfile().role == 'admin';
    }

    // IMPORTANT: keep this list identical to ADMIN_EMAILS in
    // js/firebase-config.js. It only matters for a user's very first
    // sign-in (before any admin document exists) — every self-created
    // profile MUST be either "pending" or this exact bootstrap-admin shape,
    // never anything a client could use to self-approve.
    function isBootstrapAdminEmail() {
      return request.auth.token.email in ['you@example.com'];
    }

    match /users/{uid} {
      // Read your own profile always; read anyone's once you're approved
      // (needed for the admin's Access Requests / All Users lists).
      allow read: if request.auth != null && (request.auth.uid == uid || isApproved());

      // A user may only ever create THEIR OWN doc, and only in one of two
      // shapes: a normal pending request, or — solely for emails in the
      // bootstrap admin list — an already-approved admin record. No other
      // combination of role/status is accepted on create, so nobody can
      // self-approve or self-promote by writing their own profile.
      allow create: if request.auth != null && request.auth.uid == uid && (
        (
          !isBootstrapAdminEmail()
          && request.resource.data.status == 'pending'
          && request.resource.data.role in ['viewer', 'editor', 'viewer_download']
        ) || (
          isBootstrapAdminEmail()
          && request.resource.data.status == 'approved'
          && request.resource.data.role == 'admin'
        )
      );

      // Only an admin can change anyone's status/role after creation
      // (approve, reject, revoke, change role) — including their own.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Any approved user (any role) can read all projects.
    // Only Editor or Admin can write.
    match /projects/{projectId} {
      allow read: if isApproved();
      allow write: if isEditor();
    }
  }
}
